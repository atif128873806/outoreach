# --- Production (docker-compose reads this file) ---

# Postgres password for the bundled db service
POSTGRES_PASSWORD=change-me

# Signs sessions and encrypts stored credentials. Generate: openssl rand -hex 32
APP_SECRET=change-me

# Public port for the app
PORT=3000

# Close registration after your accounts exist (optional)
# SIGNUPS_DISABLED=true

# Only if you must run production over plain HTTP (e.g. LAN): allow non-secure session cookies
# INSECURE_COOKIES=true

# Public URL of this instance (used in welcome-email links)
# APP_URL=https://outreach.example.com

# --- Free AI for all accounts (global fallback key; users can still override in Settings) ---
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# JINA_API_KEY=

# --- Web search (the engine behind every source and the decision-maker finder) ---
# Without this, web search runs on Exa's shared free allowance: a DAILY budget the
# whole deployment draws on, so a handful of searches exhausts it and every user
# after that gets "out of its free daily allowance" until 00:00 UTC — including
# the people behind a company. With the deployment's own key, searches and
# decision-maker look-ups are answered against this deployment's plan instead.
# Belongs to the DEPLOYMENT, never to a user. Free tier: dashboard.exa.ai
# EXA_API_KEY=

# --- Lead sources ---
# Companies House, the official UK register. This key belongs to the DEPLOYMENT,
# not to each customer: set it once here and "Companies House (UK)" is offered to
# everyone with no key for a user to paste. Unset, the source is not offered at
# all (rather than offered and then failing on submit).
# Free REST key, read-only public data: developer.company-information.service.gov.uk
# Choose "REST" as the key type when the site asks.
# COMPANIES_HOUSE_API_KEY=

# Hard ceiling on included-AI generations per user per day (cost brake).
# Overrides plan limits, including Pro's "unlimited". Recommended in production.
# GLOBAL_AI_DAILY_LIMIT=2000

# --- Product shape ---
# The product is one feature: real-time lead generation with a website audit.
# The outreach half (campaigns, message center, SMTP/IMAP, deliverability) is
# hidden and unreachable unless this is set to true. Read at build time for the
# route guard, so flipping it on a running deployment needs a rebuild.
# OUTREACH_ENABLED=true

# --- Public-facing identity (shown on /terms, /privacy, /refund-policy, /contact, /pricing) ---
# SUPPORT_EMAIL=support@yourdomain.com
# LEGAL_OPERATOR=Your Company or Name

# --- System (transactional) mailer: welcome emails from your company mailbox ---
# SYSTEM_SMTP_HOST=smtp.yourhost.com
# SYSTEM_SMTP_PORT=465
# SYSTEM_SMTP_SECURE=true
# SYSTEM_SMTP_USER=info@yourdomain.com
# SYSTEM_SMTP_PASS=
# SYSTEM_FROM_EMAIL=info@yourdomain.com
# SYSTEM_FROM_NAME=Outreach Studio

# --- Local development ---
# Leave DATABASE_URL unset to use the embedded PGlite database in data/pg.
# DATABASE_URL=postgres://user:pass@localhost:5432/outreach
