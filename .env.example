# --- Production (docker-compose reads this file) ---

# Postgres password for the bundled db service
POSTGRES_PASSWORD=change-me

# Signs sessions and encrypts stored credentials. Generate: openssl rand -hex 32
APP_SECRET=change-me

# Public port for the app
PORT=3000

# Close registration after your accounts exist (optional)
# SIGNUPS_DISABLED=true

# Only if you must run production over plain HTTP (e.g. LAN): allow non-secure session cookies
# INSECURE_COOKIES=true

# --- Optional: global fallbacks (users can also set keys per-account in Settings) ---
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# JINA_API_KEY=

# --- Local development ---
# Leave DATABASE_URL unset to use the embedded PGlite database in data/pg.
# DATABASE_URL=postgres://user:pass@localhost:5432/outreach
